NODE_ENV=production
GOOGLE_CLOUD_PROJECT=dreamytales-498114
GOOGLE_CLOUD_LOCATION=global
# Non-secret story-generation controls. Change in Cloud Run to revise future stories.
STORY_LLM_MODEL=gemini-3.7-flash
STORY_LLM_TEMPERATURE=0.7
# Optional. Use a single-line custom author persona or system-style instruction.
# STORY_BASE_PROMPT=You are a gentle, imaginative children's story author who writes soothing bedtime stories.
DATABASE_SOCKET_PATH=/cloudsql/dreamytales-498114:us-central1:dreamy-tales-db
DATABASE_USER=dreamy_tales
DATABASE_NAME=dreamy_tales
# Set DATABASE_PASSWORD from Secret Manager when deploying; do not commit its value.
